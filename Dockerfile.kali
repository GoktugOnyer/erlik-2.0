FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive

# ===== Core pentest tools via apt =====
RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap ffuf sqlmap nuclei nikto gobuster dirb wfuzz \
    whatweb wafw00f hydra commix arjun \
    john hashcat \
    curl wget python3 python3-pip python3-venv \
    netcat-openbsd dnsutils whois \
    testssl.sh \
    # Node.js for Playwright
    nodejs npm \
    # Chromium deps for Playwright
    chromium \
    libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
    libxcomposite1 libxrandr2 libgbm1 libpango-1.0-0 \
    libcairo2 libasound2t64 libxdamage1 libxshmfence1 \
    # Build tools for Go binaries
    ca-certificates git unzip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ===== nuclei templates =====
# Required for nuclei to do anything; the apt package only installs the binary.
# Templates land in /root/.local/nuclei-templates by default.
RUN nuclei -update-templates -silent 2>/dev/null || true

# ===== Wordlists =====
RUN mkdir -p /usr/share/wordlists && \
    wget -q "https://github.com/brannondorsey/naive-hashcat/releases/download/data/rockyou.txt" \
        -O /usr/share/wordlists/rockyou.txt

# ===== Python tools via pip =====
RUN pip3 install --no-cache-dir --break-system-packages \
    sslyze \
    XSStrike \
    python-owasp-zap-v2.4

# ===== Playwright =====
RUN npm install -g playwright@latest 2>/dev/null || true
ENV PLAYWRIGHT_BROWSERS_PATH=/usr/lib/chromium
ENV NODE_PATH=/usr/local/lib/node_modules
# Playwright will use the system chromium

# ===== dalfox (XSS scanner) — Go binary from GitHub =====
RUN ARCH=$(dpkg --print-architecture) && \
    DALFOX_VERSION="2.9.3" && \
    if [ "$ARCH" = "amd64" ]; then \
        wget -q "https://github.com/hahwul/dalfox/releases/download/v${DALFOX_VERSION}/dalfox_${DALFOX_VERSION}_linux_amd64.tar.gz" -O /tmp/dalfox.tar.gz && \
        tar -xzf /tmp/dalfox.tar.gz -C /usr/local/bin dalfox && \
        chmod +x /usr/local/bin/dalfox && \
        rm /tmp/dalfox.tar.gz; \
    elif [ "$ARCH" = "arm64" ]; then \
        wget -q "https://github.com/hahwul/dalfox/releases/download/v${DALFOX_VERSION}/dalfox_${DALFOX_VERSION}_linux_arm64.tar.gz" -O /tmp/dalfox.tar.gz && \
        tar -xzf /tmp/dalfox.tar.gz -C /usr/local/bin dalfox && \
        chmod +x /usr/local/bin/dalfox && \
        rm /tmp/dalfox.tar.gz; \
    fi

# ===== jwt_tool =====
RUN git clone --depth 1 https://github.com/ticarpi/jwt_tool.git /opt/jwt_tool && \
    pip3 install --no-cache-dir --break-system-packages -r /opt/jwt_tool/requirements.txt && \
    ln -s /opt/jwt_tool/jwt_tool.py /usr/local/bin/jwt_tool && \
    chmod +x /opt/jwt_tool/jwt_tool.py

# ===== crlfuzz (CRLF injection scanner) — Go binary =====
RUN ARCH=$(dpkg --print-architecture) && \
    CRLFUZZ_VERSION="1.4.1" && \
    if [ "$ARCH" = "amd64" ]; then \
        wget -q "https://github.com/dwisiswant0/crlfuzz/releases/download/v${CRLFUZZ_VERSION}/crlfuzz_${CRLFUZZ_VERSION}_linux_amd64.tar.gz" -O /tmp/crlfuzz.tar.gz && \
        tar -xzf /tmp/crlfuzz.tar.gz -C /usr/local/bin crlfuzz && \
        chmod +x /usr/local/bin/crlfuzz && \
        rm /tmp/crlfuzz.tar.gz; \
    elif [ "$ARCH" = "arm64" ]; then \
        wget -q "https://github.com/dwisiswant0/crlfuzz/releases/download/v${CRLFUZZ_VERSION}/crlfuzz_${CRLFUZZ_VERSION}_linux_arm64.tar.gz" -O /tmp/crlfuzz.tar.gz && \
        tar -xzf /tmp/crlfuzz.tar.gz -C /usr/local/bin crlfuzz && \
        chmod +x /usr/local/bin/crlfuzz && \
        rm /tmp/crlfuzz.tar.gz; \
    fi

# ===== OWASP Nettacker (deterministic pre-scan automation, Apache-2.0) =====
# Invoked (not vendored) by orchestrator/integrations/nettacker.py via
# `docker exec kali-tools nettacker ...`. Installed from PyPI (newer Nettacker
# uses Poetry, so there is no root requirements.txt to pip -r). The `nettacker`
# CLI is exposed by a wrapper running it as a module.
#
# Nettacker is OFF by default (ERLIK_NETTACKER), so this step is BEST-EFFORT: a
# failure here must never break the image (which carries every other tool). If
# it fails, ERLIK_NETTACKER simply degrades to an empty result at runtime.
RUN ( pip3 install --no-cache-dir --break-system-packages nettacker \
      && printf '#!/bin/bash\nexec python3 -m nettacker "$@"\n' > /usr/local/bin/nettacker \
      && chmod +x /usr/local/bin/nettacker \
      && echo "[erlik] nettacker installed" ) \
    || echo "[erlik] WARN: nettacker install failed — ERLIK_NETTACKER unavailable until fixed"

# ===== ProjectDiscovery recon suite (MIT) — milestone C =====
# subfinder  passive subdomain enumeration
# dnsx       DNS resolution of candidate names
# httpx      liveness probe + title + tech fingerprint
# katana     crawler — endpoint and parameter discovery
#
# katana earns its place on evidence rather than convention: class-restricted
# scoring across 28 recorded runs showed the agent lane's bottleneck is REACHING
# an endpoint, not knowing what to do once there (SSRF was never found even when
# the exact path was handed over). Crawling attacks that directly; more prompt
# guidance does not.
#
# Installed as pinned release binaries, matching the dalfox/crlfuzz pattern
# above. Best-effort per tool: recon degrades to "tool unavailable" at runtime,
# and must never break an image that carries every other tool.
RUN ARCH=$(dpkg --print-architecture) && \
    for spec in "subfinder:2.16.0" "dnsx:1.3.0" "httpx:1.10.0" "katana:1.7.0"; do \
        TOOL="${spec%%:*}"; VER="${spec##*:}"; \
        URL="https://github.com/projectdiscovery/${TOOL}/releases/download/v${VER}/${TOOL}_${VER}_linux_${ARCH}.zip"; \
        ( wget -q "$URL" -O "/tmp/${TOOL}.zip" \
          && unzip -o -q "/tmp/${TOOL}.zip" -d /usr/local/bin "${TOOL}" \
          && chmod +x "/usr/local/bin/${TOOL}" \
          && rm -f "/tmp/${TOOL}.zip" \
          && echo "[erlik] ${TOOL} v${VER} installed" ) \
        || echo "[erlik] WARN: ${TOOL} install failed — recon degrades without it"; \
    done

# ===== Rekono-parity toolset =====
# Nine tools erlik lacked that a working pentester expects, all in Kali's own
# repositories. Chosen to close specific gaps rather than to lengthen a list:
#
#   theharvester  OSINT — emails and subdomains from public sources
#   dirsearch     content discovery (alternative shape to ffuf/gobuster)
#   sslscan       TLS cipher/protocol audit (sslyze's faster complement)
#   gitleaks      exposed secrets in a repository or a dumped .git
#   ssh-audit     SSH algorithm and key exchange audit
#   smbmap        SMB share enumeration
#   cmseek        CMS identification
#   joomscan      Joomla-specific checks
#   exploitdb     provides `searchsploit` — LOOKUP ONLY, never exploitation
#
# Metasploit is already present in the base image but is deliberately NOT
# registered as an erlik tool: `searchsploit` answers "is there a known exploit"
# without the agent being handed a working exploitation framework.
#
# Best-effort, matching every other tool step: a repository hiccup must not
# break an image that carries everything else. A tool that fails to install
# reports "not installed" at runtime rather than failing a scan silently.
RUN apt-get update && \
    ( apt-get install -y --no-install-recommends \
        theharvester dirsearch sslscan gitleaks ssh-audit \
        smbmap cmseek joomscan exploitdb \
      && echo "[erlik] rekono-parity toolset installed" ) \
    || echo "[erlik] WARN: part of the parity toolset failed to install" ; \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# ===== ZAP CLI helper script =====
RUN echo '#!/bin/bash\n\
# Wrapper to call ZAP API from kali container\n\
ZAP_HOST="${ZAP_HOST:-zap}"\n\
ZAP_PORT="${ZAP_PORT:-8080}"\n\
ZAP_BASE="http://${ZAP_HOST}:${ZAP_PORT}"\n\
\n\
case "$1" in\n\
  spider)\n\
    curl -s "${ZAP_BASE}/JSON/spider/action/scan/?url=$2&maxChildren=10&recurse=true"\n\
    ;;\n\
  active-scan)\n\
    curl -s "${ZAP_BASE}/JSON/ascan/action/scan/?url=$2&recurse=true"\n\
    ;;\n\
  alerts)\n\
    curl -s "${ZAP_BASE}/JSON/alert/view/alerts/?baseurl=$2&start=0&count=100"\n\
    ;;\n\
  status)\n\
    curl -s "${ZAP_BASE}/JSON/core/view/version/"\n\
    ;;\n\
  spider-status)\n\
    curl -s "${ZAP_BASE}/JSON/spider/view/status/?scanId=$2"\n\
    ;;\n\
  scan-status)\n\
    curl -s "${ZAP_BASE}/JSON/ascan/view/status/?scanId=$2"\n\
    ;;\n\
  ajax-spider)\n\
    curl -s "${ZAP_BASE}/JSON/ajaxSpider/action/scan/?url=$2"\n\
    ;;\n\
  summary)\n\
    curl -s "${ZAP_BASE}/JSON/alert/view/alertsSummary/?baseurl=$2"\n\
    ;;\n\
  *)\n\
    echo "ZAP CLI Wrapper"\n\
    echo "Usage: zap-cli <command> [target_url]"\n\
    echo "Commands: spider, active-scan, alerts, status, spider-status, scan-status, ajax-spider, summary"\n\
    ;;\n\
esac' > /usr/local/bin/zap-cli && chmod +x /usr/local/bin/zap-cli

# ===== Playwright crawl helper =====
# Simple wrapper that 7B LLMs can invoke like any other tool
# Usage: pw-crawl http://juice-shop:3000
COPY scripts/pw-crawl.js /usr/local/bin/pw-crawl.js
RUN printf '#!/bin/bash\nNODE_PATH=/usr/local/lib/node_modules node /usr/local/bin/pw-crawl.js "$@"\n' > /usr/local/bin/pw-crawl && \
    chmod +x /usr/local/bin/pw-crawl

# ===== Capability helpers (RQ3-b / IDOR-UI action space) =====
# Three deterministic scripts that extend what the LLM agent can DO
# without adding any detection logic. See scripts/*.sh and
# scripts/interactive-pw.js for full docs.

# interactive-pw: scriptable Playwright recipe runner (accepts JSON on stdin)
COPY scripts/interactive-pw.js /usr/local/bin/interactive-pw.js
RUN printf '#!/bin/bash\nNODE_PATH=/usr/local/lib/node_modules node /usr/local/bin/interactive-pw.js "$@"\n' > /usr/local/bin/interactive-pw && \
    chmod +x /usr/local/bin/interactive-pw

# login-helper: fetch two Juice Shop sessions (user + admin) as JSON
COPY scripts/login-helper.sh /usr/local/bin/login-helper
RUN chmod +x /usr/local/bin/login-helper

# diff-view: dumb HTTP response diff viewer for differential IDOR probes
COPY scripts/diff-view.sh /usr/local/bin/diff-view
RUN chmod +x /usr/local/bin/diff-view

WORKDIR /work
CMD ["tail", "-f", "/dev/null"]
